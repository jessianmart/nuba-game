{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/assets/arena/:path*",
      "destination": "/assets/stage/arena/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/audio/decoded/(.*)\\.ogg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
