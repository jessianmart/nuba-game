# Repo cru — nao vai pro deploy
tools/
docs/
*.log
*.bak_*
public/**/*.bak_*
__pycache__/
.hermes/

# Extracoes nao usadas em runtime (verificado: 0 refs em game.js/styles.css/arenas.json)
public/assets/models/puppets/
public/assets/ui/raw/
public/assets/ui/_sheets/
public/assets/ui/slices/
public/assets/ui/battle/

# PV-B.4 — lixo de extracao (auditado por tools/audit_runtime_refs.py: 464 refs, 0 ausentes)
public/assets/stage/raw/          # 194 MB de stages brutos do APK
public/assets/data/spc/           # 26 MB de tabelas de combate do APK
public/assets/data/stage_meta/    # StageAreaInfo.bin.xfbin
public/assets/data/so_symbols.json
public/assets/data/so_class_index.json
public/assets/data/so_strings.json
public/assets/data/*.md
public/assets/stage/*.png          # 42 MB de texturas legadas (stage_3d.json so usa arena/*)

# Banks brutos de audio (runtime usa public/assets/audio/decoded/*.ogg)
public/assets/audio/*.xfbin
public/assets/audio/*.acf
public/assets/audio/*.nus3conf

