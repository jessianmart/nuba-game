  'Konoha Senpuu (Furacão da Folha)': '木ノ葉旋風', 'Omote Renge (Lótus Primária)': '表蓮華', 'Retirada Pesos de Treino': '瞬身', 'Ura Renge (Oito Portões Internos)': '裏蓮華',
  'Amaterasu (Chamas Negras)': '天照', 'Katon: Gokakyu + Clone Explosivo': '火遁・爆分身', 'Genjutsu de Corvos': '幻術・烏', 'Tsukuyomi + Susanoo': '月読',
  'Sabaku Kyuu (Caixão de Areia)': '砂縛柩', 'Suna no Tate (Escudo Absoluto)': '砂の盾', 'Substituição de Areia': '砂替わり', 'Sabaku Taisou + Shukaku': '砂漠大葬',
  'Shugohakke Rokujuyonsho': '守護八卦六十四掌', 'Punho dos Leões Gêmeos': '双獅拳', 'Byakugan Kawarimi': '白眼', 'Oito Trigramas: Leões Gêmeos Supremos': '双獅拳・極',
  'Hakkeshō Kaiten (Rotação)': '回天', 'Hakke Kuusho (Palma de Ar)': '八卦空掌', 'Byakugan Evasão': '白眼', 'Oito Trigramas: 64 Golpes': '八卦六十四掌',
  'Katon: Gamayu Endan': '蛤蟆油弾', 'Hari Jizo (Escudo de Espinhos)': '針地蔵', 'Kawarimi do Sapo': '蛤蟇替わり', 'Chou Oodama Rasengan + Modo Sennin': '仙法・大玉螺旋丸',
  'Combo Uzumaki + Kunai': '打撃', 'Uchiha Taijutsu + Shuriken': '手裏剣', 'Punho de Chakra Concentrado': '拳', 'Kunai Relâmpago + Taijutsu': '雷遁',
  'Punho Forte Acelerado': '木ノ葉拳', 'Shuriken Uchiha + Corvos': '烏', 'Rajada de Areia': '砂', 'Punho Gentil (Juken)': '柔拳',
  'Juken: Golpe de Tenketsu': '柔拳', 'Taijutsu Eremita dos Sapos': '仙法'
}; // M4.2 HUD PASS: kanji do kill-feed

function addKillFeed(killer, victim, skillName) {
  const feed = document.getElementById('kill-feed');
  if (!feed) return;
  const item = document.createElement('div');
  item.className = 'kill-toast';
  const kColor = killer.team === 'blue' ? '#60a5fa' : '#f87171';
  const vColor = victim.team === 'blue' ? '#60a5fa' : '#f87171';
  const kName = killer.name.split(' ')[0];
  const vName = victim.name.split(' ')[0];
  const baseSkill = String(skillName || '').replace(/\s*\[.*\]\s*$/, ''); // M4.2 HUD PASS
  const jpHtml = KILL_FEED_JP[baseSkill] ? ` <span class="feed-jp">${KILL_FEED_JP[baseSkill]}</span>` : '';
  item.innerHTML = `
    <img class="feed-portrait" src="${killer.portrait}" alt="${kName}" />
    <span class="feed-name" style="color:${kColor}">${kName}</span>
    <span class="feed-ability-tag">[${skillName}]</span>${jpHtml}
    <span class="feed-arrow">➔</span>
    <img class="feed-portrait" src="${victim.portrait}" alt="${vName}" />
    <span class="feed-name" style="color:${vColor}">${vName}</span>
  `;
  feed.prepend(item);
  while (feed.children.length > 5) feed.lastChild.remove();

  setTimeout(() => {
    item.classList.add('fade-out');
  }, 4200);

  setTimeout(() => {
    if (item.parentNode) item.remove();
  }, 4700);
}

// ============================================================================
// EXTRACTED 3D SKILL VFX & COMBAT JUTSU ENGINE ({cid}eff1.xfbin)
// ============================================================================
function buildExtractedVfxMeshGroup(heroId, colorHex, targetScale = 0.08, modelName = null) {
  const vfxDef = skillVfxData[heroId] || skillVfxData['common'] || skillVfxData['1ssk'] || skillVfxData['1gar'];
  if (!vfxDef) return null;

  let meshesToUse = null;
  if (modelName && vfxDef.models && vfxDef.models[modelName]) {
    meshesToUse = vfxDef.models[modelName];
  } else if (modelName && skillVfxData['common'] && skillVfxData['common'].models && skillVfxData['common'].models[modelName]) {
    meshesToUse = skillVfxData['common'].models[modelName];
  } else if (vfxDef.meshes && vfxDef.meshes.length > 0) {
    meshesToUse = vfxDef.meshes.slice(0, 3);
  } else if (skillVfxData['common'] && skillVfxData['common'].models) {
    meshesToUse = skillVfxData['common'].models['1efc_chakra00'] || null;
  }
  if (!meshesToUse || meshesToUse.length === 0) return null;

  const grp = new THREE.Group();
  grp.scale.setScalar(targetScale);

  for (const sm of meshesToUse) {
    const geom = new THREE.BufferGeometry();
    geom.setAttribute('position', new THREE.BufferAttribute(new Float32Array(sm.positions), 3));
    if (sm.uvs && sm.uvs.length > 0) {
      geom.setAttribute('uv', new THREE.BufferAttribute(new Float32Array(sm.uvs), 2));
    }
    if (sm.indices && sm.indices.length > 0) {
      geom.setIndex(sm.indices);
    }

    const texPath = sm.texture ? `assets/${sm.texture}` : null;
    const mapTex = loadTex(texPath);
    const mat = new THREE.MeshBasicMaterial({
      map: mapTex,
      color: colorHex || 0xffffff,
      transparent: true,
      opacity: 0.9,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      side: THREE.DoubleSide
    });
    const m = new THREE.Mesh(geom, mat);
    grp.add(m);
  }
  return grp;
}

function createHeroAwakeningAuraMesh(heroId, colorHex) {
  const grp = new THREE.Group();

  const vfxAura = buildExtractedVfxMeshGroup(heroId, colorHex, 0.065);
  if (vfxAura) {
    vfxAura.position.y = 2.2;
    grp.add(vfxAura);
  } else {
    const sphere = new THREE.Mesh(
      new THREE.SphereGeometry(2.6, 16, 16),
      new THREE.MeshBasicMaterial({
        color: colorHex,
        transparent: true,
        opacity: 0.45,
        wireframe: false,
        blending: THREE.AdditiveBlending,
        depthWrite: false
      })
    );
    sphere.position.y = 2.7;
    grp.add(sphere);
  }

  // Authentic Storm Awakening Ground Aura Rings / Shockwave Ripples
  const ringGeo1 = new THREE.RingGeometry(2.0, 2.55, 32);
  const ringMat1 = new THREE.MeshBasicMaterial({
    color: colorHex,
    side: THREE.DoubleSide,
    transparent: true,
    opacity: 0.75,
    blending: THREE.AdditiveBlending
  });
  const groundRing1 = new THREE.Mesh(ringGeo1, ringMat1);
  groundRing1.rotation.x = -Math.PI / 2;
  groundRing1.position.y = 0.12;
  groundRing1.name = 'groundRing1';
  grp.add(groundRing1);

  const ringGeo2 = new THREE.RingGeometry(3.0, 3.45, 32);
  const ringMat2 = new THREE.MeshBasicMaterial({
    color: 0xfde047,
    side: THREE.DoubleSide,
    transparent: true,
    opacity: 0.55,
    blending: THREE.AdditiveBlending
  });
  const groundRing2 = new THREE.Mesh(ringGeo2, ringMat2);
  groundRing2.rotation.x = -Math.PI / 2;
  groundRing2.position.y = 0.14;
  groundRing2.name = 'groundRing2';
  grp.add(groundRing2);

  return grp;
}

function findNearestEnemy(unit, maxDist = 45) {
  let best = null;
  let bestD = maxDist;
  for (const other of units) {
    if (other.team === unit.team || other.deadTimer > 0) continue;
    const d = Math.hypot(other.x - unit.x, other.z - unit.z);
    if (d < bestD) {
      bestD = d;
      best = other;
    }
  }
  return best;
}

function spawnVFX(x, y, z, color, radius = 3.5, duration = 0.45, style = 'sphere', heroId = null) {
  // Spawn extracted 3D VFX mesh from {cid}eff1.xfbin alongside procedural shockwave
  if (heroId && (style === 'sphere' || style === 'pillar' || style === 'ring')) {
    const extGrp = buildExtractedVfxMeshGroup(heroId, color, radius * 0.022);
    if (extGrp) {
      extGrp.position.set(x, y, z);
      arenaGroup.add(extGrp);
      vfxList.push({ mesh: extGrp, age: 0, duration: duration * 1.15, style: 'extracted' });
    }
  }

  let geo;
  if (style === 'ring') {
    geo = new THREE.TorusGeometry(radius * 0.6, 0.25, 10, 24);
  } else if (style === 'pillar') {
    geo = new THREE.CylinderGeometry(radius * 0.5, radius * 0.7, radius * 3.2, 16);
  } else {
    geo = new THREE.IcosahedronGeometry(radius * 0.55, 1);
  }
  const mat = new THREE.MeshBasicMaterial({
    color,
    transparent: true,
    opacity: 0.85,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    wireframe: false
  });
  const mesh = new THREE.Mesh(geo, mat);
  mesh.position.set(x, y, z);
  if (style === 'ring') mesh.rotation.x = Math.PI / 2;
  arenaGroup.add(mesh);
  vfxList.push({ mesh, age: 0, duration, style });
}

// ============================================================================
// 3D NINJA WEAPONS (SHURIKEN & KUNAI) & CUSTOM JUTSU VFX GENERATORS
// ============================================================================
function createShurikenMesh() {
  const shape = new THREE.Shape();
  const numPoints = 4;
  const rOuter = 0.82;
  const rInner = 0.24;
  for (let i = 0; i < numPoints * 2; i++) {
    const angle = (i * Math.PI) / numPoints;
    const r = (i % 2 === 0) ? rOuter : rInner;
    const x = Math.cos(angle) * r;
    const y = Math.sin(angle) * r;
    if (i === 0) shape.moveTo(x, y);
    else shape.lineTo(x, y);
  }
  shape.closePath();

  const holePath = new THREE.Path();
  holePath.absarc(0, 0, 0.11, 0, Math.PI * 2, true);
  shape.holes.push(holePath);

  const extrudeSettings = {
    depth: 0.05,
    bevelEnabled: true,
    bevelSegments: 2,
    steps: 1,
    bevelSize: 0.03,
    bevelThickness: 0.03
  };
  const geo = new THREE.ExtrudeGeometry(shape, extrudeSettings);
  geo.center();
  const mat = new THREE.MeshStandardMaterial({
    color: 0x1e293b,
    metalness: 0.92,
    roughness: 0.22,
    side: THREE.DoubleSide
  });
  const mesh = new THREE.Mesh(geo, mat);
  mesh.rotation.x = Math.PI / 2;
  return mesh;
}

function createKunaiMesh() {
  const grp = new THREE.Group();
  const bladeShape = new THREE.Shape();
  bladeShape.moveTo(0, 1.35);
  bladeShape.lineTo(0.24, 0.45);
  bladeShape.lineTo(0.10, 0.0);
  bladeShape.lineTo(-0.10, 0.0);
  bladeShape.lineTo(-0.24, 0.45);
  bladeShape.closePath();

  const bladeGeo = new THREE.ExtrudeGeometry(bladeShape, {
    depth: 0.05,
    bevelEnabled: true,
    bevelSegments: 2,
    steps: 1,
    bevelSize: 0.03,
    bevelThickness: 0.03
  });
  bladeGeo.center();
  const steelMat = new THREE.MeshStandardMaterial({
    color: 0x334155,
    metalness: 0.88,
    roughness: 0.24
  });
  const bladeMesh = new THREE.Mesh(bladeGeo, steelMat);
  bladeMesh.position.y = 0.68;
  grp.add(bladeMesh);

  const collarGeo = new THREE.CylinderGeometry(0.12, 0.12, 0.08, 12);
  const collarMesh = new THREE.Mesh(collarGeo, steelMat);
  collarMesh.position.y = 0.0;
  grp.add(collarMesh);

  const handleGeo = new THREE.CylinderGeometry(0.065, 0.065, 0.75, 10);
  const handleMat = new THREE.MeshStandardMaterial({
    color: 0xf8fafc,
    roughness: 0.85,
    metalness: 0.05
  });
  const handleMesh = new THREE.Mesh(handleGeo, handleMat);
  handleMesh.position.y = -0.42;
  grp.add(handleMesh);

  const ringGeo = new THREE.TorusGeometry(0.13, 0.035, 8, 16);
  const ringMesh = new THREE.Mesh(ringGeo, steelMat);
  ringMesh.position.y = -0.88;
  grp.add(ringMesh);

  grp.scale.setScalar(1.25);
  return grp;
}

function createProceduralLightningArcs(radius = 1.35, count = 10, color = 0x93c5fd) {
  const segmentsPerArc = 5;
  const totalPoints = count * segmentsPerArc * 2;
  const positions = new Float32Array(totalPoints * 3);
  const geom = new THREE.BufferGeometry();
  geom.setAttribute('position', new THREE.BufferAttribute(positions, 3));

  function randomizeArcs() {
    let pIdx = 0;
    for (let a = 0; a < count; a++) {
      const u = Math.random();
      const v = Math.random();
      const theta = u * 2.0 * Math.PI;
      const phi = Math.acos(2.0 * v - 1.0);
      const sinPhi = Math.sin(phi);
      const startR = radius * (0.35 + Math.random() * 0.25);
      const endR = radius * (1.15 + Math.random() * 0.55);

      const sX = startR * sinPhi * Math.cos(theta);
      const sY = startR * sinPhi * Math.sin(theta);
      const sZ = startR * Math.cos(phi);

      const thetaE = theta + (Math.random() - 0.5) * 1.2;
      const phiE = phi + (Math.random() - 0.5) * 1.2;
      const eX = endR * Math.sin(phiE) * Math.cos(thetaE);
      const eY = endR * Math.sin(phiE) * Math.sin(thetaE);
      const eZ = endR * Math.cos(phiE);

      let prevX = sX, prevY = sY, prevZ = sZ;
      for (let s = 1; s <= segmentsPerArc; s++) {
        const frac = s / segmentsPerArc;
        let curX = sX + (eX - sX) * frac;
        let curY = sY + (eY - sY) * frac;
        let curZ = sZ + (eZ - sZ) * frac;
        if (s < segmentsPerArc) {
          const jitter = radius * 0.32;
          curX += (Math.random() - 0.5) * jitter;
          curY += (Math.random() - 0.5) * jitter;
          curZ += (Math.random() - 0.5) * jitter;
        }
        positions[pIdx++] = prevX;
        positions[pIdx++] = prevY;
        positions[pIdx++] = prevZ;
        positions[pIdx++] = curX;
        positions[pIdx++] = curY;
        positions[pIdx++] = curZ;
        prevX = curX;
        prevY = curY;
        prevZ = curZ;
      }
    }
    geom.attributes.position.needsUpdate = true;
  }

  randomizeArcs();
  const mat = new THREE.LineBasicMaterial({
    color,
    transparent: true,
    opacity: 0.95,
    blending: THREE.AdditiveBlending,
    depthWrite: false
  });
  const lines = new THREE.LineSegments(geom, mat);
  let arcTimer = 0;
  lines.userData = {
    updateArcs: function(dt) {
      arcTimer += dt;
      if (arcTimer > 0.04) {
        arcTimer = 0;
        randomizeArcs();
      }
    }
  };
  return lines;
}

function createRasenganMesh(radius = 1.4, color = 0x00d4ff) {
  const grp = new THREE.Group();
  const extRas = buildExtractedVfxMeshGroup('1nrt', color, radius * 0.045, 'spl_rasengan') ||
                 buildExtractedVfxMeshGroup('1nrt', color, radius * 0.045, 'rasengan') ||
                 buildExtractedVfxMeshGroup('common', color, radius * 0.045, '1efc_chakra00');
  if (extRas) grp.add(extRas);

  // 1. Glowing white inner core with subtle jitter
  const coreMat = new THREE.MeshBasicMaterial({
    color: 0xffffff,
    transparent: true,
    opacity: 0.95,
    blending: THREE.AdditiveBlending,
    depthWrite: false
  });
  const core = new THREE.Mesh(new THREE.SphereGeometry(radius * 0.62, 16, 16), coreMat);
  core.userData = {
    jitter: 0.12,
    baseScale: 1.0,
    rotSpeed: new THREE.Vector3(0, 8, 0)
  };
  grp.add(core);

  // 2. Outer swirling chakra sphere with 1efc_chakra00.png
  const chakraTex = loadTex('assets/skills/1efc_chakra00.png');
  const sphereMat = new THREE.MeshBasicMaterial({
    color,
    map: chakraTex,
    transparent: true,
    opacity: 0.85,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    side: THREE.DoubleSide,
    wireframe: false
  });
  const shell = new THREE.Mesh(new THREE.SphereGeometry(radius, 24, 24), sphereMat);
  shell.userData = {
    rotSpeed: new THREE.Vector3(0, 20, 0),
    uvScroll: { x: 0.8, y: 1.4 }
  };
  grp.add(shell);

  // 3. Three gyroscopic counter-rotating rings with 1efc_ring01.png
  const ringTex = loadTex('assets/skills/1efc_ring01.png');
  const ringMat = new THREE.MeshBasicMaterial({
    color: 0x38bdf8,
    map: ringTex,
    transparent: true,
    opacity: 0.9,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    side: THREE.DoubleSide
  });
  const ringVels = [
    new THREE.Vector3(14, 18, 0),
    new THREE.Vector3(0, -16, 20),
    new THREE.Vector3(-18, 0, -14)
  ];
  for (let i = 0; i < 3; i++) {
    const ring = new THREE.Mesh(new THREE.TorusGeometry(radius * 1.08, 0.075, 8, 32), ringMat);
    ring.rotation.set((i * Math.PI) / 3, (i * Math.PI) / 4, (i * Math.PI) / 6);
    ring.userData = { rotSpeed: ringVels[i] };
    grp.add(ring);
  }
  return grp;
}

function createChidoriMesh(radius = 1.35, color = 0x60a5fa) {
  const grp = new THREE.Group();
  const extChi = buildExtractedVfxMeshGroup('1ssk', color, radius * 0.045, 'chidori_spark') ||
                 buildExtractedVfxMeshGroup('1ssk', color, radius * 0.045, '1sskeff1_aura01') ||
                 buildExtractedVfxMeshGroup('common', color, radius * 0.045, '1efc_spk01');
  if (extChi) grp.add(extChi);

  // 1. Blinding white/cyan electric plasma core with stochastic jitter
  const coreMat = new THREE.MeshBasicMaterial({
    color: 0xffffff,
    transparent: true,
    opacity: 0.95,
    blending: THREE.AdditiveBlending,
    depthWrite: false
  });
  const core = new THREE.Mesh(new THREE.SphereGeometry(radius * 0.58, 16, 16), coreMat);
  core.userData = {
    jitter: 0.35,
    baseScale: 1.0,
    rotSpeed: new THREE.Vector3(12, 16, 8)
  };
  grp.add(core);

  // 2. High-voltage lightning plasma dome with 1efc_spk01.png
  const spkTex = loadTex('assets/skills/1efc_spk01.png');
  const domeMat = new THREE.MeshBasicMaterial({
    color,
    map: spkTex,
    transparent: true,
    opacity: 0.85,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    side: THREE.DoubleSide,
    wireframe: false
  });
  const dome = new THREE.Mesh(new THREE.IcosahedronGeometry(radius * 0.95, 2), domeMat);
  dome.userData = {
    rotSpeed: new THREE.Vector3(18, -22, 14),
    jitter: 0.28,
    baseScale: 1.0,
    uvScroll: { x: 1.2, y: 1.6 }
  };
  grp.add(dome);

  // 3. Dynamic procedural zigzag lightning discharge arcs
  const arcs = createProceduralLightningArcs(radius, 12, 0x93c5fd);
  grp.add(arcs);

  // 4. Electric spark planes
  for (let i = 0; i < 4; i++) {
    const spPlane = new THREE.Mesh(
      new THREE.PlaneGeometry(radius * 0.9, radius * 0.9),
      new THREE.MeshBasicMaterial({
        map: spkTex,
        color: 0xffffff,
        transparent: true,
        opacity: 0.88,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        side: THREE.DoubleSide
      })
    );
    spPlane.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI);
    spPlane.userData = {
      rotSpeed: new THREE.Vector3(
        (Math.random() - 0.5) * 20,
        (Math.random() - 0.5) * 20,
        (Math.random() - 0.5) * 20
      )
    };
    grp.add(spPlane);
  }

  return grp;
}

